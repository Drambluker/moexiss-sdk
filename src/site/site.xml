<!-- Дескриптор сайта проекта MOEX ISS SDK. -->
<site xmlns="http://maven.apache.org/SITE/2.0.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://maven.apache.org/SITE/2.0.0 https://maven.apache.org/xsd/site-2.0.0.xsd"
      name="MOEX ISS SDK">
    <bannerLeft name="MOEX ISS SDK" />
    <publishDate />
    <version />
    <skin>
        <groupId>org.apache.maven.skins</groupId>
        <artifactId>maven-fluido-skin</artifactId>
        <version>1.7</version>
    </skin>
    <body>
        <links>
            <item name="English" href="${project.url}" />
            <item name="На русском" href="${project.url}/ru" />
            <item name="GitHub" href="https://github.com/Drambluker/moexiss-sdk" />
            <item name="Eric Vlaskin" href="https://eric.vlaskin.org" />
        </links>
        <menu ref="parent" />
        <menu ref="modules" />
        <menu ref="reports" />
    </body>
    <custom>
        <fluidoSkin>
            <topBarEnabled>true</topBarEnabled>
            <sideBarEnabled>false</sideBarEnabled>
        </fluidoSkin>
    </custom>
</site>
